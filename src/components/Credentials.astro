---
const credentials = [
  {
    name: 'SEDRONAR',
    image: 'sedronar',
    width: 1000,
    height: 331,
    dark: true,
    detail: 'Secretaría de Políticas Integrales sobre Drogas',
  },
  {
    name: 'RENPRE',
    image: 'renpre',
    width: 314,
    height: 129,
    detail: 'Registro Nacional de Precursores Químicos',
  },
  {
    name: 'SENASA',
    image: 'senasa',
    width: 432,
    height: 117,
    detail: 'Sanidad y calidad agroalimentaria',
  },
  {
    name: 'PCRMA',
    image: 'pcrma',
    width: 225,
    height: 225,
    detail: 'Programa de Cuidado Responsable del Medio Ambiente',
  },
  {
    name: 'ISTA',
    image: 'ista',
    width: 1024,
    height: 329,
    detail: 'Certified Laboratory',
  },
];
---

<section class="section credentials reveal" aria-labelledby="credentials-title">
  <div class="section-inner">
    <div class="credentials-heading">
      <div>
        <span class="eyebrow">Respaldo para cada operación</span>
        <h2 id="credentials-title">
          Habilitaciones y<br />
          certificaciones vigentes.
        </h2>
      </div>
      <p>
        El compromiso de hacer las cosas bien también forma parte de nuestra
        operación.
      </p>
    </div>
    <ul class="credentials-grid">
      {credentials.map(({ name, image, width, height, dark, detail }) => (
        <li>
          <div
            class:list={['credential-logo', { 'credential-logo--dark': dark }]}
          >
            <img
              src={`images/credentials/${image}.png`}
              class={`credential-image--${image}`}
              alt={`Logo ${name}`}
              width={width}
              height={height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="credential-copy">
            <h3>{name}</h3>
            <p>{detail}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .credentials {
    background: var(--paper-2);
    border-top: 1px solid var(--line);
  }
  .credentials-heading {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: end;
    margin-bottom: 40px;
  }
  .credentials-heading h2 {
    margin-bottom: 0;
    font-size: clamp(2.4rem, 4vw, 4rem);
  }
  .credentials-heading > p {
    max-width: 360px;
    color: #555951;
    line-height: 1.75;
    margin: 0 0 6px;
  }
  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 16px;
  }
  .credentials-grid li {
    background: #fff;
    border: 1px solid #dedfd7;
    border-top: 2px solid #b9bcb5;
    min-width: 0;
  }
  .credential-logo {
    height: 140px;
    padding: 26px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .credential-logo--dark {
    background: #fff;
  }
  .credential-logo img {
    max-width: 100%;
    max-height: 72px;
    width: 160px;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    transition: filter 240ms ease;
  }
  .credential-logo {
    transition: background 240ms ease;
  }
  .credential-logo .credential-image--sedronar {
    filter: grayscale(1) brightness(0.4);
    width: 176px;
  }
  .credential-logo .credential-image--renpre {
    width: 146px;
  }
  .credential-logo .credential-image--senasa {
    width: 176px;
  }
  .credential-logo .credential-image--pcrma {
    width: 70px;
  }
  .credential-logo .credential-image--ista {
    width: 150px;
  }
  @media (hover: hover) {
    .credentials-grid li:hover img {
      filter: none;
    }
    .credentials-grid li:hover .credential-logo--dark {
      background: #172637;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .credential-logo,
    .credential-logo img {
      transition: none;
    }
  }
  .credential-copy {
    padding: 20px;
    border-top: 1px solid #edece7;
  }
  .credential-copy h3 {
    font:
      600 0.95rem/1.4 Inter,
      sans-serif;
    margin: 0 0 8px;
  }
  .credential-copy p {
    color: #555951;
    font-size: 0.8rem;
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 980px) {
    .credentials-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .credentials-heading {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .credentials-heading > p {
      max-width: 560px;
    }
  }
  @media (max-width: 650px) {
    .credentials-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .credential-logo {
      height: 112px;
      padding: 18px 14px;
    }
    .credential-logo img {
      max-height: 68px;
    }
    .credential-copy {
      padding: 16px 14px;
    }
    .credentials-grid li:last-child {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
    .credentials-grid li:last-child .credential-copy {
      border-top: 0;
      border-left: 1px solid #edece7;
    }
  }
</style>

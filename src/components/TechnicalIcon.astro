---
const { name } = Astro.props;
---

<span class="technical-icon" aria-hidden="true">
  {name === 'route' && (
    <svg viewBox="0 0 48 48" fill="none"><path d="M9 37 36 10M29 10h7v7"/><circle cx="11" cy="36" r="4"/></svg>
  )}
  {name === 'fleet' && (
    <svg viewBox="0 0 48 48" fill="none"><path d="M7 15h23v19H7zM30 22h7l5 6v6H30z"/><circle cx="15" cy="36" r="4"/><circle cx="36" cy="36" r="4"/><path d="M12 21h13"/></svg>
  )}
  {name === 'track' && (
    <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="23" r="14"/><circle cx="24" cy="23" r="4"/><path d="M24 4v5M24 37v7M5 23h5M38 23h5M14 13l4 4M34 13l-4 4"/></svg>
  )}
  {name === 'storage' && (
    <svg viewBox="0 0 48 48" fill="none"><path d="M6 19 24 8l18 11v23H6zM13 24h22M13 31h22M13 38h22M17 19v23M31 19v23"/></svg>
  )}
</span>

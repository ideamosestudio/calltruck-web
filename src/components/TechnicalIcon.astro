---
const { name } = Astro.props;
---

<span class="technical-icon" aria-hidden="true">
  {name === 'route' && (
    <svg viewBox="0 0 48 48" fill="none">
      <circle cx="11" cy="36" r="4" />
      <circle cx="37" cy="12" r="4" />
      <path d="M11 32V20a8 8 0 0 1 16 0v8a5 5 0 0 0 10 0V16" />
    </svg>
  )}
  {name === 'fleet' && (
    <svg viewBox="0 0 48 48" fill="none">
      <path d="M7 15h23v19H7zM30 22h7l5 6v6H30z" />
      <circle cx="15" cy="36" r="4" />
      <circle cx="36" cy="36" r="4" />
      <path d="M12 21h13" />
    </svg>
  )}
  {name === 'track' && (
    <svg viewBox="0 0 48 48" fill="none">
      <path d="M37 19c0 10-13 23-13 23S11 29 11 19a13 13 0 1 1 26 0Z" />
      <circle cx="24" cy="19" r="4.5" />
    </svg>
  )}
  {name === 'storage' && (
    <svg viewBox="0 0 48 48" fill="none">
      <path d="M6 19 24 8l18 11v23H6zM13 24h22M13 31h22M13 38h22M17 19v23M31 19v23" />
    </svg>
  )}
</span>

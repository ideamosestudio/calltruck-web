---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/**/*.{jpg,png,webp}',
  { eager: true },
);
const {
  src,
  alt,
  sizes = '(max-width: 650px) 100vw, 50vw',
  width,
  height,
  ...attributes
} = Astro.props;
const image = images[`../assets/${src}`]?.default;
if (!image) throw new Error(`Missing image: ${src}`);
const maxWidth = Math.min(Number(width) || 1600, image.width);
const widths = [
  ...new Set([480, 800, 1200, maxWidth].filter((value) => value <= maxWidth)),
];
---

<Image
  src={image}
  alt={alt}
  width={maxWidth}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={78}
  loading="lazy"
  decoding="async"
  {...attributes}
/>

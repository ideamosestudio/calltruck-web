---
import ArrowIcon from './ArrowIcon.astro';
const formEndpoint = 'https://forms.calltruck.com.ar/contact.php';
---

<section class="section contact-panel reveal" id="consulta">
  <div class="section-inner contact-panel__grid">
    <div class="contact-panel__intro">
      <span class="eyebrow">Contacto</span>
      <h2>Contanos qué necesitás mover.</h2>
      <p>
        Completá el formulario y la consulta llegará directamente a nuestro
        equipo. Si preferís, contactanos por teléfono o WhatsApp.
      </p>
      <div class="contact-panel__quick">
        <a href="tel:+541137997864">
          <span>Teléfono</span>
          <strong>+54 11 3799-7864</strong>
        </a>
        <a
          href="https://wa.me/541137874158?text=Hola%2C%20quiero%20hacer%20una%20consulta"
          target="_blank"
          rel="noreferrer"
        >
          <span>WhatsApp</span>
          <strong>
            +54 11 3787-4158 <ArrowIcon />
          </strong>
        </a>
        <a href="mailto:info@calltruck.com.ar">
          <span>Email</span>
          <strong>info@calltruck.com.ar</strong>
        </a>
      </div>
    </div>
    <form
      class="contact-form contact-form--shared"
      action={formEndpoint}
      method="POST"
      accept-charset="UTF-8"
    >
      <input
        class="form-honeypot"
        type="text"
        name="_honey"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <div class="form-heading">
        <span class="eyebrow">Solicitar presupuesto</span>
        <h3>Datos de la consulta</h3>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="contact-name">Nombre y apellido</label>
          <input
            id="contact-name"
            name="name"
            autocomplete="name"
            maxlength="120"
            required
          />
        </div>
        <div class="field">
          <label for="contact-company">Empresa (opcional)</label>
          <input
            id="contact-company"
            name="company"
            autocomplete="organization"
            maxlength="160"
          />
        </div>
        <div class="field">
          <label for="contact-phone">Teléfono / WhatsApp</label>
          <input
            id="contact-phone"
            name="phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            maxlength="40"
            required
          />
        </div>
        <div class="field">
          <label for="contact-email">Correo electrónico</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            inputmode="email"
            autocapitalize="none"
            spellcheck="false"
            autocomplete="email"
            maxlength="254"
            required
          />
        </div>
        <div class="field field--full">
          <label for="contact-service">Servicio</label>
          <select id="contact-service" name="service" required>
            <option value="">Seleccioná una opción</option>
            <option>Transporte para particulares</option>
            <option>Logística para empresas</option>
            <option>Almacenamiento logístico</option>
            <option>Otra consulta</option>
          </select>
        </div>
        <div class="field field--full">
          <label for="contact-message">¿Qué necesitás resolver?</label>
          <textarea
            id="contact-message"
            name="message"
            maxlength="5000"
            required
          ></textarea>
        </div>
      </div>
      <button class="button" type="submit">
        Enviar consulta{' '}
        <span>
          <ArrowIcon />
        </span>
      </button>
      <p class="form-status" role="status" aria-live="polite" tabindex="-1"></p>
      <noscript>
        Para enviar el formulario activá JavaScript o escribinos a
        info@calltruck.com.ar.
      </noscript>
      <p class="form-note">La consulta se enviará a info@calltruck.com.ar.</p>
    </form>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLFormElement>('.contact-form--shared')
    .forEach((form) => {
      const button = form.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      )!;
      const status = form.querySelector<HTMLElement>('.form-status')!;
      let challenge: Promise<{ token: string }> | null = null;
      let started = 0;
      let readyAt = 0;
      const prepare = () => {
        if (!challenge || Date.now() - started > 3000000) {
          started = Date.now();
          challenge = fetch(form.action, {
            mode: 'cors',
            credentials: 'omit',
            cache: 'no-store',
            signal: AbortSignal.timeout(15000),
          }).then(async (r) => {
            if (!r.ok)
              throw new Error(
                'El formulario no está disponible. Intentá más tarde o escribinos por WhatsApp.',
              );
            const result = await r.json();
            readyAt = Date.now();
            return result;
          });
          challenge.catch(() => {});
        }
        return challenge;
      };
      form.addEventListener('focusin', prepare);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (button.disabled) return;
        button.disabled = true;
        form.setAttribute('aria-busy', 'true');
        status.textContent = 'Enviando consulta…';
        try {
          const { token } = await prepare();
          await new Promise((resolve) =>
            setTimeout(resolve, Math.max(0, 2500 - (Date.now() - readyAt))),
          );
          const data = Object.fromEntries(new FormData(form));
          const response = await fetch(form.action, {
            method: 'POST',
            credentials: 'omit',
            signal: AbortSignal.timeout(15000),
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...data, token }),
          });
          const result = await response.json();
          if (!response.ok || !result.ok)
            throw new Error(
              result.error || 'No se pudo enviar. Intentá más tarde.',
            );
          form.reset();
          status.textContent =
            '¡Gracias! Tu consulta fue enviada. Te responderemos a la brevedad.';
        } catch (error) {
          status.textContent =
            error instanceof Error
              ? error.message
              : 'No se pudo conectar. Intentá más tarde o escribinos por WhatsApp.';
        } finally {
          challenge = null;
          button.disabled = false;
          form.removeAttribute('aria-busy');
          status.focus({ preventScroll: true });
        }
      });
    });
</script>
<style>
  .form-status:not(:empty) {
    margin-top: 20px;
    color: #fff;
    line-height: 1.6;
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
</style>

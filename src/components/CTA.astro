---
const { title, text, label = 'Pedir presupuesto', message = 'Hola, quiero pedir un presupuesto' } = Astro.props;
const href = `https://wa.me/541137874158?text=${encodeURIComponent(message)}`;
---
<section class="final-cta reveal">
  <div class="cta-track" aria-hidden="true">MOVEMOS · CONECTAMOS · RESOLVEMOS · </div>
  <div class="final-cta__inner">
    <div><span class="eyebrow eyebrow--dark">HABLEMOS DE TU OPERACIÓN</span><h2>{title}</h2><p>{text}</p></div>
    <a class="button button--dark button--large" href={href} target="_blank" rel="noreferrer">{label}<span>↗</span></a>
  </div>
</section>


---
const whatsapp = 'https://wa.me/541137874158?text=Hola%2C%20quiero%20pedir%20un%20presupuesto';
const navigation = [['Inicio', '.'], ['La empresa', 'la-empresa/'], ['Soluciones', 'soluciones/'], ['Contacto', 'contacto/']];
const services = [['Transporte para vos', 'transporte-particulares/'], ['Logística para empresas', 'logistica-empresas/'], ['Almacenamiento logístico', 'almacenamiento-logistico/']];
---
<footer class="footer-premium">
  <div class="footer-shell">
    <div class="footer-statement">
      <div><span class="footer-kicker">El próximo movimiento, juntos.</span><p>Dejala venir.<br /><strong>La logística la hacemos nosotros.</strong></p></div>
      <a class="footer-talk" href={whatsapp} target="_blank" rel="noreferrer"><span>Hablemos de tu proyecto</span><span class="footer-talk__arrow" aria-hidden="true">↗</span></a>
    </div>
    <div class="footer-directory">
      <div class="footer-identity">
        <a class="footer-logo" href="." aria-label="Calltruck, inicio"><img src="images/calltruck-logo.webp" width="900" height="300" alt="CALLTRUCK" loading="lazy" /></a>
        <p>Transporte, logística<br />y almacenamiento.</p>
        <div class="footer-socials" aria-label="Redes sociales">
          <a href="https://www.instagram.com/transporte.calltruck/" target="_blank" rel="noreferrer" aria-label="Seguir a Calltruck en Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1"/></svg>Instagram <span aria-hidden="true">↗</span></a>
          <a href="https://www.linkedin.com/search/results/companies/?keywords=Transporte%20y%20logistica%20Calltruck%20SRL" target="_blank" rel="noreferrer" aria-label="Buscar Transporte y logística Calltruck SRL en LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 10v7M7.5 7.2v.1M11 17v-7m0 3c0-4 5.5-4 5.5 0v4"/></svg>LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <nav class="footer-column" aria-label="Navegación del pie"><h2>Explorá</h2>{navigation.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
      <nav class="footer-column" aria-label="Servicios del pie"><h2>Soluciones</h2>{services.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
      <div class="footer-column footer-contact"><h2>Estamos cerca</h2>
        <a class="footer-phone" href="tel:+541137997864">+54 11 3799-7864</a>
        <a href={whatsapp} target="_blank" rel="noreferrer">WhatsApp: +54 11 3787-4158 <span aria-hidden="true">↗</span></a>
        <a class="footer-email" href="mailto:transporte.calltruck@hotmail.com">Transporte.calltruck@hotmail.com</a>
        <a class="footer-address" href="https://www.google.com/maps/search/?api=1&query=La%20Santa%20Mar%C3%ADa%20728%2C%20Paso%20del%20Rey%2C%20Moreno" target="_blank" rel="noreferrer"><span>La Santa María 728<br />Paso del Rey, Moreno</span><span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="footer-colophon"><span>© {new Date().getFullYear()} Calltruck. Todos los derechos reservados.</span><span><i aria-hidden="true"></i> Industria argentina · Movimiento nacional</span></div>
  </div>
</footer>
<style>
  .footer-premium{background:#0c0e0d;color:#f7f4ec;padding:0 var(--pad);border-top:1px solid #30332e}
  .footer-shell{max-width:var(--max);margin:auto}
  .footer-statement{display:flex;align-items:center;justify-content:space-between;gap:3rem;padding:4.5rem 0;border-bottom:1px solid #30332e}
  .footer-kicker{display:block;color:#c0c3bb;font-size:.72rem;letter-spacing:.13em;text-transform:uppercase;margin-bottom:1.6rem}
  .footer-statement p{font-family:'Barlow Condensed',Impact,sans-serif;font-size:clamp(2.6rem,4.4vw,4.6rem);font-weight:600;line-height:1.04;text-transform:uppercase;letter-spacing:-.015em;max-width:850px}
  .footer-statement strong{font-weight:700;color:var(--orange)}
  .footer-talk{flex-shrink:0;display:flex;align-items:center;gap:1.4rem;font-size:.88rem;font-weight:500}
  .footer-talk__arrow{display:grid;place-items:center;width:64px;height:64px;border:1px solid #62665c;border-radius:50%;font-size:1.75rem;transition:background .25s,color .25s,border-color .25s,transform .25s}
  .footer-talk:hover .footer-talk__arrow{background:var(--orange);border-color:var(--orange);color:#111;transform:rotate(45deg)}
  .footer-directory{display:grid;grid-template-columns:1.1fr .55fr .9fr 1.25fr;gap:clamp(1.5rem,3vw,3.5rem);padding:4rem 0 4.5rem}
  .footer-directory>*{min-width:0}
  .footer-logo{display:block;width:240px;max-width:100%;margin:-.65rem 0 1.1rem}
  .footer-logo img{width:100%;height:auto}
  .footer-identity>p{color:#b6bbb2;font-size:.94rem;line-height:1.75}
  .footer-socials{display:flex;flex-wrap:wrap;gap:.65rem 1.2rem;margin-top:1.7rem}
  .footer-socials a{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;font-size:.78rem;color:#d9dcd5}
  .footer-socials svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  .footer-socials a>span{color:#969e90}
  .footer-column{display:flex;align-items:flex-start;flex-direction:column;gap:.75rem}
  .footer-column h2{font-family:Inter,Arial,sans-serif;font-size:.72rem;font-weight:600;line-height:1.4;letter-spacing:.13em;color:#b1b8aa;margin:0 0 1rem;text-transform:uppercase}
  .footer-column>a{font-size:.88rem;line-height:1.65;color:#e1e4dc;max-width:100%;text-decoration-color:transparent;text-underline-offset:5px;transition:color .2s,text-decoration-color .2s}
  .footer-column>a:hover,.footer-socials a:hover{color:var(--orange);text-decoration:underline}
  .footer-contact .footer-phone{font-family:'Barlow Condensed',sans-serif;font-size:1.9rem;line-height:1.15;font-weight:600;letter-spacing:.02em;margin-top:-.2rem}
  .footer-email{overflow-wrap:anywhere}
  .footer-contact .footer-address{display:flex;justify-content:space-between;align-items:center;gap:1rem;width:100%;border-top:1px solid #30332e;padding-top:1.1rem;margin-top:.4rem;color:#b6bbb2}
  .footer-address>span:last-child{color:var(--orange)}
  .footer-colophon{display:flex;justify-content:space-between;gap:1rem 2rem;padding:1.5rem 0 6rem;border-top:1px solid #30332e;color:#a5ada0;font-size:.72rem;line-height:1.6}
  .footer-colophon>span:last-child{display:flex;align-items:center;gap:.6rem}
  .footer-colophon i{width:6px;height:6px;border-radius:50%;background:var(--orange);flex-shrink:0}
  @media(max-width:1100px){.footer-statement{align-items:flex-start;flex-direction:column;gap:2rem}.footer-directory{grid-template-columns:1fr .7fr 1.1fr;gap:3rem}.footer-identity{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:0 2rem}.footer-identity>p{grid-column:1}.footer-socials{grid-column:2;grid-row:1/3;justify-self:end;margin:0}.footer-logo{width:230px}.footer-statement p{font-size:clamp(3rem,5.8vw,4.6rem)}}
  @media(max-width:650px){.footer-statement{padding:3.2rem 0;gap:1.8rem}.footer-kicker{font-size:.65rem;margin-bottom:1.25rem}.footer-statement p{font-size:clamp(2.45rem,10.3vw,3.8rem);line-height:1.08}.footer-talk{justify-content:space-between;width:100%;font-size:.85rem}.footer-talk__arrow{width:48px;height:48px;font-size:1.4rem}.footer-directory{grid-template-columns:.8fr 1.2fr;gap:2.5rem 1.5rem;padding:3rem 0}.footer-identity{display:block}.footer-logo{width:220px}.footer-identity>p{font-size:.9rem}.footer-socials{margin-top:1rem;gap:1.5rem}.footer-column{gap:.45rem}.footer-column h2{margin-bottom:.9rem;font-size:.68rem}.footer-column>a{font-size:.86rem;min-height:36px;display:flex;align-items:center}.footer-contact{grid-column:1/-1;border-top:1px solid #30332e;padding-top:2.3rem}.footer-contact .footer-phone{font-size:2.1rem}.footer-contact .footer-address{padding-top:1rem;margin-top:.5rem}.footer-colophon{flex-direction:column;font-size:.7rem;padding:1.5rem 0 2rem;gap:.8rem}.footer-colophon>span:last-child{font-size:.65rem}}
  @media(prefers-reduced-motion:reduce){.footer-talk__arrow,.footer-column>a{transition:none}.footer-talk:hover .footer-talk__arrow{transform:none}}
</style>

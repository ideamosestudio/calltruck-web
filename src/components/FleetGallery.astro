---
const items = [
  { src: 'images/editorial/truck-calltruck-wide.webp', alt: 'Unidad Calltruck con semirremolque en plataforma logística', label: 'Capacidad operativa', meta: 'Larga distancia', wide: true },
  { src: 'images/editorial/truck-urban-black.webp', alt: 'Camión de carga urbana dentro de un centro logístico', label: 'Operaciones urbanas', meta: 'Carga general' },
  { src: 'images/editorial/truck-semi-rain.webp', alt: 'Semirremolque de gran porte preparado para operar', label: 'Larga distancia', meta: 'Cobertura nacional', wide: true },
  { src: 'images/editorial/truck-container.webp', alt: 'Transporte de contenedor en plataforma logística', label: 'Contenedores', meta: 'Equipos especiales' },
  { src: 'images/editorial/truck-semi-side.webp', alt: 'Camión con semirremolque dentro de un depósito', label: 'Semirremolques', meta: 'Gran porte' },
  { src: 'images/editorial/truck-calltruck-square.webp', alt: 'Unidad Calltruck con semirremolque', label: 'Capacidad operativa', meta: 'Flota versátil', wide: true },
  { src: 'images/editorial/truck-route-purple.webp', alt: 'Unidad de transporte durante una operación en ruta', label: 'Distribución nacional', meta: 'En movimiento', wide: true },
  { src: 'images/editorial/truck-urban-white.webp', alt: 'Camión mediano con caja de cortina', label: 'Cargas generales', meta: 'Distribución' },
  { src: 'images/editorial/truck-blue-rear.webp', alt: 'Vista posterior de unidad con plataforma hidráulica', label: 'Equipamiento', meta: 'Carga y descarga' },
];
const { compact = false } = Astro.props;
---

<div class:list={['fleet-gallery', { 'fleet-gallery--compact': compact }]}>
  {items.map((item, index) => (
    <figure class:list={['fleet-shot', { 'fleet-shot--wide': item.wide }]}>
      <img src={item.src} alt={item.alt} loading="lazy" />
      <span class="fleet-shot__frame" aria-hidden="true"></span>
      <figcaption><span>0{index + 1}</span><strong>{item.label}</strong>{item.meta && <small>{item.meta}</small>}</figcaption>
    </figure>
  ))}
</div>

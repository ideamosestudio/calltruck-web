---
const items = [
  { src: 'images/editorial/fleet-brand.webp', alt: 'Unidad Calltruck con semirremolque en plataforma logística', label: 'Capacidad operativa', meta: 'Larga distancia', wide: true },
  { src: 'images/editorial/fleet-urban.webp', alt: 'Camión de carga liviana dentro de un centro logístico', label: 'Operaciones urbanas', meta: 'Carga general' },
  { src: 'images/editorial/fleet-longhaul.webp', alt: 'Semirremolque de gran porte en playa logística', label: 'Larga distancia', meta: 'Cobertura nacional', wide: true },
  { src: 'images/fleet/portacontenedor.webp', alt: 'Transporte de contenedor en playa logística', label: 'Contenedores' },
  { src: 'images/fleet/tractor-semirremolque.webp', alt: 'Camión con semirremolque en plataforma logística', label: 'Equipos especiales' },
  { src: 'images/fleet/calltruck-semirremolque.webp', alt: 'Unidad Calltruck con semirremolque', label: 'Capacidad operativa', wide: true },
  { src: 'images/fleet/operacion-ruta.webp', alt: 'Unidad de transporte durante una operación en ruta', label: 'Distribución nacional', wide: true },
  { src: 'images/fleet/chasis-liviano-02.webp', alt: 'Camión mediano con caja de cortina', label: 'Cargas generales' },
  { src: 'images/fleet/chasis-cortina-posterior.webp', alt: 'Vista posterior de unidad con plataforma hidráulica', label: 'Equipamiento' },
];
const { compact = false } = Astro.props;
---

<div class:list={['fleet-gallery', { 'fleet-gallery--compact': compact }]}>
  {items.map((item, index) => (
    <figure class:list={['fleet-shot', { 'fleet-shot--wide': item.wide }]}>
      <img src={item.src} alt={item.alt} loading="lazy" />
      <span class="fleet-shot__frame" aria-hidden="true"></span>
      <figcaption><span>0{index + 1}</span><strong>{item.label}</strong>{item.meta && <small>{item.meta}</small>}</figcaption>
    </figure>
  ))}
</div>

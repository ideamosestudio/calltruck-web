---
import HeroBackdrop from './HeroBackdrop.astro';
import SiteImage from './SiteImage.astro';
import ArrowIcon from './ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from './CTA.astro';
const {
  metaTitle,
  metaDescription,
  eyebrow,
  title,
  lead,
  heroCTA,
  message,
  introTitle,
  introText,
  items,
  supportEyebrow = 'Respaldo operativo',
  supportTitle,
  supportText,
  finalTitle,
  finalText,
  finalLabel,
  heroImage = 'images/fleet/chasis-cortina-frente.webp',
  supportImage = 'images/fleet/semirremolque-negro.webp',
} = Astro.props;
const wa = `https://wa.me/541137874158?text=${encodeURIComponent(message)}`;
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <section class="hero hero--service">
    <HeroBackdrop
      src={heroImage}
      gradient="linear-gradient(90deg,rgba(10,12,11,.96) 0%,rgba(10,12,11,.72) 44%,rgba(10,12,11,.1) 82%)"
    />
    <div class="hero-grid"></div>
    <span class="hero-index">CALLTRUCK · SOLUCIONES</span>
    <div class="hero-content">
      <span class="eyebrow">{eyebrow}</span>
      <h1 set:html={title} />
      <p class="hero-lead">{lead}</p>
      <div class="hero-actions">
        <a class="button" href={wa} target="_blank" rel="noreferrer">
          {heroCTA}
          <span>
            <ArrowIcon />
          </span>
        </a>
      </div>
    </div>
  </section>
  <section class="section reveal">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <span class="eyebrow">Cómo trabajamos</span>
          <h2>{introTitle}</h2>
        </div>
        <p>{introText}</p>
      </div>
      <ol class="transfer-steps">
        {items.map((item, i) => (
          <li class="transfer-step">
            <span class="transfer-step__number" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
      <div class="transfer-action">
        <a class="button button--dark" href={`${Astro.url.pathname}#consulta`}>
          Consultar mi traslado <ArrowIcon direction="down" />
        </a>
      </div>
    </div>
  </section>
  <section class="split split--service reveal">
    <div class="split-media">
      <SiteImage
        src={supportImage}
        alt="Unidad de transporte de carga de Calltruck"
        loading="lazy"
      />
      <span class="image-tag">Movimiento nacional</span>
    </div>
    <div class="split-copy">
      <span class="eyebrow">{supportEyebrow}</span>
      <h2>{supportTitle}</h2>
      <p>{supportText}</p>
      <a class="button button--dark" href={wa} target="_blank" rel="noreferrer">
        Consultar operación{' '}
        <span>
          <ArrowIcon />
        </span>
      </a>
    </div>
  </section>
  <CTA
    title={finalTitle}
    text={finalText}
    label={finalLabel}
    message={message}
  />
</BaseLayout>

<style>
  .transfer-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .transfer-step {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    row-gap: 18px;
    padding: 30px;
    border: 1px solid #d6d7cf;
    border-top: 3px solid var(--accent);
    background: #faf9f3;
    box-shadow: 0 8px 24px rgb(16 19 16 / 3%);
  }
  .transfer-step__number {
    display: block;
    padding-bottom: 20px;
    font:
      800 60px/1 'Barlow Condensed',
      sans-serif;
    color: var(--accent);
  }
  .transfer-step h3 {
    font:
      800 clamp(1.7rem, 2.2vw, 2rem)/1.05 'Barlow Condensed',
      sans-serif;
    text-transform: uppercase;
    letter-spacing: -0.015em;
    margin: 0;
    max-width: 310px;
  }
  .transfer-step p {
    margin: 0;
    font-size: 0.95rem;
    color: #555951;
    line-height: 1.7;
  }
  .transfer-action {
    margin-top: 32px;
  }
  @media (max-width: 980px) {
    .transfer-steps {
      gap: 0 16px;
    }
    .transfer-step {
      padding: 24px;
    }
  }
  @media (max-width: 760px) {
    .transfer-steps {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .transfer-step {
      grid-template-rows: auto auto auto;
      grid-row: auto;
      row-gap: 14px;
    }
    .transfer-step__number {
      font-size: 48px;
      padding-bottom: 8px;
    }
    .transfer-step h3 {
      max-width: none;
    }
  }
</style>

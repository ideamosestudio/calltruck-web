---
const clients = [
  ['andreani', 'Andreani', true],
  ['cachamai', 'Cachamai', false],
  ['locksley', 'Locksley', true],
  ['tml', 'TML', false],
  ['toshin', 'Toshin', false],
  ['violetta', 'Violetta', true],
  ['lit', 'LIT', false],
];
---

<section class="client-logos" aria-label="Empresas con las que trabajamos">
  <div class="client-logos__viewport">
    <div class="client-logos__track">
      {[0, 1].map((copy) => (
        <ul
          class="client-logos__group"
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {clients.map(([file, name, wide]) => (
            <li
              class:list={[
                'client-logos__item',
                `client-logos__item--${file}`,
                { 'is-wide': wide },
              ]}
            >
              <img
                src={`${import.meta.env.BASE_URL}images/clients/${file}.webp`}
                alt={copy === 0 ? String(name) : ''}
                width="220"
                height="96"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
  <button
    class="client-logos__pause"
    type="button"
    aria-label="Pausar movimiento de logos"
    aria-pressed="false"
  >
    <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
      <path
        class="pause-symbol"
        d="M7 5v10M13 5v10"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <path class="play-symbol" d="m7 4 9 6-9 6z" fill="currentColor" />
    </svg>
  </button>
</section>

<style>
  .client-logos {
    position: relative;
    background: #0c0e0d;
    border-top: 1px solid #ffffff14;
    border-bottom: 1px solid #ffffff14;
    padding: 30px 0;
  }
  .client-logos__viewport {
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 6%,
      #000 94%,
      transparent
    );
  }
  .client-logos__track {
    display: flex;
    width: max-content;
    animation: client-drift 42s linear infinite;
  }
  .client-logos__group {
    display: flex;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .client-logos__item {
    width: 240px;
    height: 112px;
    padding: 8px 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .client-logos__item img {
    width: 86px;
    height: 86px;
    object-fit: contain;
    filter: grayscale(1) brightness(0) invert(0.86);
    opacity: 0.9;
    transition:
      filter 0.3s,
      opacity 0.3s;
  }
  .client-logos__item.is-wide img {
    width: 190px;
    height: 76px;
  }
  .client-logos__item--cachamai img {
    width: 146px;
    height: 86px;
  }
  .client-logos__item--tml img {
    width: 128px;
    height: 92px;
  }
  .client-logos__item--lit img {
    filter: grayscale(1);
  }
  .client-logos__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  .client-logos:hover .client-logos__track,
  .client-logos:focus-within .client-logos__track,
  .client-logos.is-paused .client-logos__track {
    animation-play-state: paused;
  }
  .client-logos__pause {
    position: absolute;
    right: 12px;
    bottom: 8px;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 1px solid #ffffff30;
    border-radius: 50%;
    background: #191c1a;
    color: #d7dade;
    cursor: pointer;
  }
  .client-logos__pause:focus-visible {
    outline: 2px solid #d7dade;
    outline-offset: 3px;
  }
  .play-symbol,
  .is-paused .pause-symbol {
    display: none;
  }
  .is-paused .play-symbol {
    display: block;
  }
  @keyframes client-drift {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 700px) {
    .client-logos {
      padding: 18px 0 30px;
    }
    .client-logos__item {
      width: 180px;
      height: 96px;
      padding: 8px 20px;
    }
    .client-logos__item img {
      width: 70px;
      height: 70px;
    }
    .client-logos__item.is-wide img {
      width: 150px;
      height: 64px;
    }
    .client-logos__item--cachamai img {
      width: 120px;
      height: 74px;
    }
    .client-logos__item--tml img {
      width: 108px;
      height: 78px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-logos__track {
      animation: none;
    }
    .client-logos__viewport {
      overflow-x: auto;
    }
    .client-logos__group[aria-hidden] {
      display: none;
    }
    .client-logos__pause {
      display: none;
    }
    .client-logos__item img {
      transition: none;
    }
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('.client-logos__pause')
    .forEach((button) => {
      button.addEventListener('click', () => {
        const paused =
          button.closest('.client-logos')?.classList.toggle('is-paused') ??
          false;
        button.setAttribute('aria-pressed', String(paused));
        button.setAttribute(
          'aria-label',
          paused
            ? 'Reanudar movimiento de logos'
            : 'Pausar movimiento de logos',
        );
      });
    });
</script>

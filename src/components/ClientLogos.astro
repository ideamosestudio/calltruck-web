---
const clients = [
  ['andreani', 'Andreani', true],
  ['cachamai', 'Cachamai', false],
  ['locksley', 'Locksley', true],
  ['tml', 'TML', true],
  ['toshin', 'Toshin', true],
  ['violetta', 'Violetta', true],
  ['lit', 'LIT', false],
  ['vatten', 'Vatten', true],
  ['bsa-burgert', 'BSA Burgert', true],
  ['renarp', 'Renarp', true],
  ['surplast', 'Surplast', true],
  ['lecker-argentina', 'Lecker Argentina', true],
];
---

<section class="client-logos" aria-label="Empresas con las que trabajamos">
  <div class="client-logos__viewport">
    <div class="client-logos__track">
      {[0, 1].map((copy) => (
        <ul
          class="client-logos__group"
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {clients.map(([file, name, wide]) => (
            <li
              class:list={[
                'client-logos__item',
                `client-logos__item--${file}`,
                { 'is-wide': wide },
              ]}
            >
              <img
                src={`${import.meta.env.BASE_URL}images/clients/${file}-transparent-v5.png`}
                alt={copy === 0 ? String(name) : ''}
                width="220"
                height="96"
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .client-logos {
    position: relative;
    background: #0c0e0d;
    border-top: 1px solid #ffffff14;
    border-bottom: 1px solid #ffffff14;
    padding: 30px 0;
  }
  .client-logos__viewport {
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 6%,
      #000 94%,
      transparent
    );
  }
  .client-logos__track {
    display: flex;
    width: max-content;
    animation: client-drift 42s linear infinite;
  }
  .client-logos__group {
    display: flex;
    flex-shrink: 0;
    gap: 72px;
    margin: 0;
    padding: 0 72px 0 0;
    list-style: none;
  }
  .client-logos__item {
    width: auto;
    flex: 0 0 auto;
    height: 112px;
    padding: 8px 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .client-logos__item img {
    width: 68px;
    height: 68px;
    object-fit: contain;
    filter: grayscale(1) brightness(0) invert(0.86);
    opacity: 0.9;
    transition:
      filter 0.3s,
      opacity 0.3s;
  }
  .client-logos__item.is-wide img {
    width: 168px;
    height: 66px;
  }
  .client-logos__item--cachamai img {
    width: 128px;
    height: 86px;
  }
  .client-logos__item--tml img {
    width: 156px;
    height: 66px;
  }
  .client-logos__item--lit img {
    filter: grayscale(1);
  }
  .client-logos .client-logos__item img {
    height: auto;
    flex-shrink: 0;
  }
  .client-logos__item:hover img {
    opacity: 1;
  }
  .client-logos:hover .client-logos__track {
    animation-play-state: paused;
  }
  @keyframes client-drift {
    to {
      transform: translateX(-50%);
    }
  }
  @media (max-width: 700px) {
    .client-logos {
      padding: 18px 0;
    }
    .client-logos__item {
      height: 96px;
      padding: 8px 0;
    }
    .client-logos__group {
      gap: 40px;
      padding-right: 40px;
    }
    .client-logos__item img {
      width: 62px;
      height: 62px;
    }
    .client-logos__item.is-wide img {
      width: 150px;
      height: 64px;
    }
    .client-logos__item--cachamai img {
      width: 120px;
      height: 62px;
    }
    .client-logos__item--tml img {
      width: 140px;
      height: 62px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .client-logos__track {
      animation: none;
    }
    .client-logos__viewport {
      overflow-x: auto;
    }
    .client-logos__group[aria-hidden] {
      display: none;
    }
    .client-logos__item img {
      transition: none;
    }
  }
</style>

---
import SiteImage from './SiteImage.astro';
const { src, gradient } = Astro.props;
---

<div
  class="hero-backdrop"
  aria-hidden="true"
  style={`--hero-gradient:${gradient}`}
>
  <SiteImage
    src={src}
    alt=""
    sizes="max(100vw, 180vh)"
    loading="eager"
    fetchpriority="high"
  />
</div>

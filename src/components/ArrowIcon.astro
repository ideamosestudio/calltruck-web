---
interface Props { direction?: 'up-right' | 'down' | 'chevron-down'; class?: string }
const { direction = 'up-right', class: className } = Astro.props;
const paths = { 'up-right': 'M6 18 18 6M6 6h12v12', down: 'M12 4v16m-7-7 7 7 7-7', 'chevron-down': 'm6 9 6 6 6-6' };
---
<svg class:list={['arrow-icon', className]} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[direction]} /></svg>

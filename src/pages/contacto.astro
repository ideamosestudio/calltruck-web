---
import ContactForm from '../components/ContactForm.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const mapQuery = 'La Santa María 728, Paso del Rey, Moreno, Buenos Aires';
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
---

<BaseLayout
  showContactForm={false}
  compactFooter={true}
  title="Contacto y presupuestos | Calltruck"
  description="Consultá a Calltruck por transporte particular, logística empresarial o almacenamiento. Contactanos por teléfono, email o WhatsApp."
>
  <section class="hero hero--service hero--contact">
    <HeroBackdrop
      src="images/editorial/hero-company.webp"
      gradient="linear-gradient(90deg,rgba(10,12,11,.97),rgba(10,12,11,.72) 48%,rgba(10,12,11,.14))"
    />
    <div class="hero-grid"></div>
    <span class="hero-index">CONTACTO · RESPUESTA DIRECTA</span>
    <div class="hero-content">
      <span class="eyebrow">Hablemos</span>
      <h1>
        Tu próximo
        <br />
        <em>movimiento</em>
        <br />
        empieza acá.
      </h1>
      <p class="hero-lead">
        Transporte, logística o almacenamiento. Contanos qué necesitás y
        coordinemos el próximo paso.
      </p>
      <div class="hero-actions">
        <a class="button" href={`${Astro.url.pathname}#consulta`}>
          Enviar una consulta{' '}
          <span>
            <ArrowIcon direction="down" />
          </span>
        </a>
        <a
          class="button button--outline"
          href="https://wa.me/541137874158?text=Hola%2C%20quiero%20hacer%20una%20consulta"
          target="_blank"
          rel="noreferrer"
        >
          Abrir WhatsApp{' '}
          <span>
            <ArrowIcon />
          </span>
        </a>
      </div>
    </div>
  </section>

  <ContactForm />
  <section
    class="section contact-location contact-location--compact reveal"
    aria-labelledby="location-title"
  >
    <div class="section-inner">
      <div class="contact-location__heading">
        <div>
          <span class="eyebrow">Base operativa</span>
          <h2 id="location-title">Dónde encontrarnos.</h2>
        </div>
        <div>
          <p>
            La Santa María 728
            <br />
            Paso del Rey, Moreno
          </p>
          <a class="text-link" href={mapLink} target="_blank" rel="noreferrer">
            Cómo llegar <ArrowIcon />
          </a>
        </div>
      </div>
      <div class="map-card">
        <iframe
          title="Ubicación de Calltruck"
          src={mapEmbed}
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <script>
    if (new URLSearchParams(location.search).get('enviado') === '1') {
      const target = document.querySelector('#consulta');
      const form = target?.querySelector('form');
      if (form) {
        const notice = document.createElement('div');
        notice.className = 'form-success';
        notice.setAttribute('role', 'status');
        notice.innerHTML =
          '<strong>Consulta enviada.</strong><span>Gracias por escribirnos. El equipo de Calltruck recibió tu mensaje.</span>';
        form.prepend(notice);
      }
      setTimeout(
        () => target?.scrollIntoView({ behavior: 'smooth', block: 'start' }),
        250,
      );
    }
  </script>
</BaseLayout>

<style>
  .hero--contact {
    min-height: 0;
    padding-top: 150px;
    padding-bottom: 64px;
  }
  .hero--contact h1 {
    font-size: clamp(42px, 5vw, 68px);
  }
  .contact-location--compact {
    padding-block: 64px;
  }
  .contact-location__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 28px;
  }
  .contact-location__heading h2 {
    margin-bottom: 0;
  }
  .contact-location__heading p {
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .contact-location__heading a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-underline-offset: 5px;
  }
  .contact-location--compact .map-card {
    min-height: 0;
  }
  .contact-location--compact iframe {
    display: block;
    width: 100%;
    height: 300px;
    min-height: 0;
    border: 0;
  }
  @media (max-width: 650px) {
    .hero--contact {
      padding-top: 120px;
      padding-bottom: 40px;
    }
    .contact-location--compact {
      padding-block: 40px;
    }
    .contact-location__heading {
      align-items: start;
      flex-direction: column;
      gap: 20px;
    }
    .contact-location--compact iframe {
      height: 260px;
    }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contacto y presupuestos | Calltruck" description="Consultá a Calltruck por transporte particular, logística empresarial o almacenamiento. Contactanos por teléfono, email o WhatsApp.">
  <section class="hero hero--service" style="background-image:linear-gradient(90deg,rgba(10,12,11,.96),rgba(10,12,11,.7) 48%,rgba(10,12,11,.12)),url('images/fleet/chasis-liviano-02.webp')"><div class="hero-grid"></div><span class="hero-index">CONTACTO · RESPUESTA DIRECTA</span><div class="hero-content"><span class="eyebrow">Hablemos</span><h1>Tu próximo<br><em>movimiento</em><br>empieza acá.</h1><p class="hero-lead">¿Necesitás transportar una carga, resolver la logística de tu empresa o consultar por almacenamiento? Contanos qué necesitás y conversemos.</p><div class="hero-actions"><a class="button" href="https://wa.me/541137874158?text=Hola%2C%20quiero%20hacer%20una%20consulta" target="_blank" rel="noreferrer">Escribir por WhatsApp <span>↗</span></a></div></div></section>
  <section class="section reveal"><div class="section-inner contact-grid">
    <div><span class="eyebrow">Canales directos</span><h2>Estamos para escucharte.</h2><div class="contact-details" style="margin-top:3rem"><div class="contact-row"><span>Teléfono</span><a href="tel:+541137797864">+54 11 3779-7864</a></div><div class="contact-row"><span>WhatsApp</span><a href="https://wa.me/541137874158?text=Hola%2C%20quiero%20hacer%20una%20consulta" target="_blank" rel="noreferrer">+54 11 3787-4158 ↗</a></div><div class="contact-row"><span>Email</span><a href="mailto:transporte.calltruck@hotmail.com">transporte.calltruck<br/>@hotmail.com</a></div><div class="contact-row"><span>Depósito</span><strong>Paso del Rey,<br/>Buenos Aires</strong></div></div></div>
    <form class="contact-form" data-contact-form><span class="eyebrow">Contanos tu necesidad</span><div class="form-grid"><div class="field"><label for="name">Nombre y apellido</label><input id="name" name="name" required /></div><div class="field"><label for="company">Empresa (opcional)</label><input id="company" name="company" /></div><div class="field"><label for="phone">Teléfono / WhatsApp</label><input id="phone" name="phone" required /></div><div class="field"><label for="email">Correo electrónico</label><input id="email" name="email" type="email" required /></div><div class="field field--full"><label for="service">¿Qué servicio necesitás?</label><select id="service" name="service" required><option value="">Seleccioná una opción</option><option>Transporte particular</option><option>Logística para empresas</option><option>Almacenamiento logístico</option><option>Otra consulta</option></select></div><div class="field field--full"><label for="message">Contanos brevemente qué necesitás</label><textarea id="message" name="message" required></textarea></div></div><button class="button" type="submit">Enviar consulta <span>↗</span></button><p style="font-size:.72rem;color:#888;margin-top:1rem">Al enviar, se abrirá WhatsApp con los datos de tu consulta.</p></form>
  </div></section>
  <section class="final-cta reveal"><div class="cta-track" aria-hidden="true">CONVERSEMOS · CONVERSEMOS ·</div><div class="final-cta__inner"><div><span class="eyebrow eyebrow--dark">Contacto directo</span><h2>¿Preferís hablar directamente?</h2><p>Escribinos por WhatsApp y contanos tu necesidad.</p></div><a class="button button--dark button--large" href="https://wa.me/541137874158?text=Hola%2C%20quiero%20hacer%20una%20consulta" target="_blank" rel="noreferrer">Abrir WhatsApp <span>↗</span></a></div></section>
  <script>
    document.querySelector('[data-contact-form]')?.addEventListener('submit',(event)=>{
      event.preventDefault();
      const form=new FormData(event.currentTarget);
      const text=[`Hola, soy ${form.get('name')}.`,`Servicio: ${form.get('service')}.`,`Empresa: ${form.get('company') || 'No indicada'}.`,`Teléfono: ${form.get('phone')}.`,`Email: ${form.get('email')}.`,`Consulta: ${form.get('message')}`].join('\n');
      window.open(`https://wa.me/541137874158?text=${encodeURIComponent(text)}`,'_blank','noopener,noreferrer');
    });
  </script>
</BaseLayout>

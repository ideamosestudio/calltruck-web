---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
const wa='https://wa.me/541137874158?text=Hola%2C%20quiero%20consultar%20por%20almacenamiento';
---
<BaseLayout title="Depósito y almacenamiento logístico | Calltruck" description="Más de 1.000 m² de almacenamiento en Paso del Rey, con acceso a Acceso Oeste y Buen Ayre. Consultá por nuestro depósito.">
  <section class="hero hero--service hero--structured" style="background-image:linear-gradient(90deg,rgba(10,12,11,.95),rgba(10,12,11,.64) 47%,rgba(10,12,11,.1)),url('images/editorial/hero-personal.webp')"><div class="hero-grid"></div><span class="hero-index">PASO DEL REY · BUENOS AIRES</span><div class="hero-content"><span class="eyebrow">Depósito y distribución</span><h1>El espacio que<br><em>tu logística</em><br>necesita.</h1><p class="hero-lead">Más de 1.000 m² de almacenamiento en Paso del Rey, en una ubicación estratégica con acceso inmediato a Acceso Oeste y Camino del Buen Ayre.</p><div class="hero-actions"><a class="button" href={wa} target="_blank" rel="noreferrer">Consultar por almacenamiento <span>↗</span></a></div></div></section>
  <section class="section reveal"><div class="section-inner editorial"><aside>01 / El depósito</aside><article><h2>Infraestructura que suma capacidad a tu operación.</h2><p>Nuestro depósito permite incorporar espacio de almacenamiento a la planificación logística.</p><p>Su ubicación facilita la conexión con las principales vías de acceso de la zona oeste del Gran Buenos Aires.</p></article></div></section>
  <section class="section section--sand reveal"><div class="section-inner"><div class="stats"><article class="stat"><strong>+1.000 m²</strong><span>Superficie de almacenamiento</span></article><article class="stat"><strong>Paso del Rey</strong><span>Ubicación del depósito</span></article><article class="stat"><strong>Accesos</strong><span>Acceso Oeste y Camino del Buen Ayre</span></article></div></div></section>
  <section class="split reveal"><div class="split-media"><img src="images/fleet/chasis-cortina-posterior.webp" alt="Unidad de carga preparada para una operación logística" loading="lazy"/><span class="image-tag">Almacenamiento + distribución</span></div><div class="split-copy"><span class="eyebrow">Mover mejor</span><h2>Almacenar es parte de una logística eficiente.</h2><p>Combinamos servicios de almacenamiento y distribución para acompañar distintas necesidades logísticas. Contanos qué mercadería necesitás guardar y cómo es tu operación.</p><a class="button button--dark" href={wa} target="_blank" rel="noreferrer">Consultar disponibilidad <span>↗</span></a></div></section>
  <CTA title="¿Necesitás espacio para tu mercadería?" text="Escribinos para conversar sobre las características y necesidades de almacenamiento de tu operación." label="Hablar sobre almacenamiento" message="Hola, quiero consultar por almacenamiento" />
</BaseLayout>

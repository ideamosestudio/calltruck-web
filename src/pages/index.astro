---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import FleetGallery from '../components/FleetGallery.astro';
const services = [
  ['01','Transporte para vos','¿Necesitás trasladar una carga? Contanos qué necesitás mover y a dónde. Te ayudamos a encontrar una solución para tu traslado.','Consultar por un traslado','transporte-particulares/'],
  ['02','Logística para empresas','Transporte nacional, distribución y operaciones logísticas para acompañar el movimiento de tu negocio.','Ver soluciones para empresas','logistica-empresas/'],
  ['03','Almacenamiento logístico','Más de 1.000 m² de depósito en Paso del Rey, con ubicación estratégica y conexión a las principales vías de acceso.','Conocer el depósito','almacenamiento-logistico/']
];
const metrics = [
  ['↗','Cobertura nacional','Operaciones de corta, media y larga distancia para distintas necesidades de transporte.'],
  ['◫','Flota versátil','Unidades propias y tercerizadas, desde utilitarios hasta semirremolques y equipos especiales.'],
  ['◎','Seguimiento operativo','Monitoreo satelital y seguimiento de las operaciones en tiempo real.'],
  ['▦','Infraestructura logística','Más de 1.000 m² de capacidad de depósito para acompañar almacenamiento y distribución.']
];
---
<BaseLayout title="Calltruck | Transporte, logística y almacenamiento" description="Transporte para particulares y empresas, distribución nacional y almacenamiento logístico. Conocé las soluciones de Calltruck.">
  <section class="hero hero--home">
    <div class="hero-grid"></div><span class="hero-index">ARGENTINA · 34°36′S</span>
    <div class="hero-content">
      <span class="eyebrow">Transporte · Logística · Almacenamiento</span>
      <h1>Movemos tu carga.<br><em>Hacemos avanzar</em><br>tus proyectos.</h1>
      <p class="hero-lead">Soluciones de transporte para particulares y empresas, distribución nacional y almacenamiento logístico. Flota, infraestructura y seguimiento operativo para acompañar cada movimiento.</p>
      <div class="hero-actions"><a class="button" href="https://wa.me/541137874158?text=Hola%2C%20quiero%20pedir%20un%20presupuesto" target="_blank" rel="noreferrer">Pedir presupuesto <span>↗</span></a><a class="button button--outline" href="#soluciones">Explorar soluciones <span>↓</span></a></div>
    </div>
  </section>

  <section id="soluciones" class="section reveal">
    <div class="section-inner">
      <div class="section-head"><div><span class="eyebrow">Lo que hacemos</span><h2>Una solución para cada necesidad.</h2></div><p>Desde un traslado puntual hasta una operación logística empresarial, conectamos tu necesidad con el servicio adecuado.</p></div>
      <div class="services-grid">{services.map(([no,title,text,label,url]) => <a class="service-card" href={url}><span class="card-no">{no} / SOLUCIÓN</span><h3>{title}</h3><p>{text}</p><span class="text-link">{label}<b>↗</b></span></a>)}</div>
    </div>
  </section>

  <section class="section section--dark reveal">
    <div class="section-inner"><div class="section-head"><div><span class="eyebrow">Capacidad para responder</span><h2>La logística necesita mucho más que llegar.</h2></div><p>Recursos concretos, seguimiento y una red operativa preparada para acompañar movimientos de distinta escala.</p></div><div class="metrics-grid">{metrics.map(([icon,title,text]) => <article class="metric"><span class="metric-icon">{icon}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div>
  </section>

  <section class="split reveal"><div class="split-copy"><span class="eyebrow">Somos Calltruck</span><h2>Un equipo que entiende de movimiento.</h2><p>Trabajamos para simplificar los desafíos del transporte y la logística con experiencia operativa, recursos adaptables y compromiso con cada entrega.</p><a class="button button--dark" href="la-empresa/">Conocé Calltruck <span>↗</span></a></div><div class="split-media"><img src="images/fleet/operacion-ruta.webp" alt="Unidad de transporte de larga distancia" loading="lazy" /><span class="image-tag">Capacidad en movimiento</span></div></section>

  <div class="band"><span class="band-label">Nuestros recursos</span><div class="band-content"><span>Utilitarios</span><span>Chasis 8–14 pallets</span><span>Semirremolques</span></div></div>

  <section class="section section--fleet reveal"><div class="section-inner"><div class="section-head"><div><span class="eyebrow">Nuestra flota</span><h2>El vehículo adecuado para cada operación.</h2></div><p>Utilitarios, chasis con capacidad de 8 a 14 pallets, unidades con pala hidráulica, semirremolques y equipos especiales.</p></div><FleetGallery compact /></div></section>

  <section class="split reveal"><div class="split-media"><img src="images/warehouse.png" alt="Interior de un depósito logístico" loading="lazy" /><span class="image-tag">Paso del Rey</span></div><div class="split-copy"><span class="eyebrow">Almacenamiento y distribución</span><h2>Espacio para que tu operación siga avanzando.</h2><p>Más de 1.000 m² de depósito en Paso del Rey, con acceso inmediato a Acceso Oeste y Camino del Buen Ayre.</p><a class="button button--dark" href="almacenamiento-logistico/">Ver almacenamiento <span>↗</span></a></div></section>

  <CTA title="Contanos qué necesitás mover." text="Ya sea un traslado puntual o una operación logística para tu empresa, conversemos sobre la solución que necesitás." />
</BaseLayout>

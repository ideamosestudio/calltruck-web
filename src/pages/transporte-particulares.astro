---
import ServicePage from '../components/ServicePage.astro';
const items = [
  {
    title: 'Contanos qué necesitás mover',
    text: 'Describí tu carga para que podamos evaluar el tipo de servicio.',
  },
  {
    title: 'Indicá el recorrido',
    text: 'Compartinos el punto de origen y el destino de tu traslado.',
  },
  {
    title: 'Consultá la disponibilidad',
    text: 'Te orientamos según las características de tu pedido.',
  },
];
---

<ServicePage
  metaTitle="Transporte para particulares | Calltruck"
  metaDescription="¿Necesitás trasladar una carga? Contanos el origen, destino y características de tu pedido. Consultá por transporte particular."
  eyebrow="Transporte para particulares"
  title="Lo que necesitás trasladar,<br><em>empieza por una consulta.</em>"
  lead="¿Tenés una carga para mover? Contanos qué necesitás trasladar, desde dónde y hacia dónde. En Calltruck te ayudamos a evaluar una solución para tu traslado."
  heroCTA="Consultar por mi traslado"
  message="Hola, quiero consultar por un traslado particular"
  introTitle="Cada traslado tiene sus particularidades."
  introText="No todas las cargas ni todos los recorridos son iguales. Por eso, el primer paso es conocer tu necesidad y las características del traslado."
  {items}
  heroImage="images/editorial/hero-slide-05.webp"
  supportImage="images/editorial/truck-urban-white.webp"
  supportEyebrow="Somos Calltruck"
  supportTitle="Una empresa de transporte detrás de tu consulta."
  supportText="Contamos con flota propia y unidades tercerizadas, distintos tipos de vehículos y experiencia en operaciones de corta, media y larga distancia."
  finalTitle="¿Tenés algo que trasladar?"
  finalText="Contanos los detalles y empecemos por encontrar la mejor forma de resolverlo."
  finalLabel="Consultar por WhatsApp"
/>

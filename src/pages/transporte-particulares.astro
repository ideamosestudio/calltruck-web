  heroImage="images/editorial/hero-slide-05.webp"
  supportImage="images/editorial/truck-urban-white.webp"
  supportEyebrow="Somos Calltruck"
  supportTitle="Una empresa de transporte detrás de tu consulta."
  supportText="Contamos con flota propia y unidades tercerizadas, distintos tipos de vehículos y experiencia en operaciones de corta, media y larga distancia."

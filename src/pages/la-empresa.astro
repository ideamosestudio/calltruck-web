---
import HeroBackdrop from '../components/HeroBackdrop.astro';
import SiteImage from '../components/SiteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import CompanyHistory from '../components/CompanyHistory.astro';
const items = [
  'Cobertura de corta, media y larga distancia.',
  'Flota propia y unidades tercerizadas.',
  'Seguimiento satelital de las operaciones.',
  'Depósito de más de 1.000 m².',
  'Equipamiento para diferentes tipos de cargas.',
  'Compromiso con los tiempos de entrega.',
];
---

<BaseLayout
  title="La empresa | Calltruck Transporte y Logística"
  description="Conocé la historia de Calltruck: una empresa familiar que comenzó en 2006 con Luis y un Mercedes-Benz 1114. Transporte, logística y almacenamiento."
>
  <section class="hero hero--service hero--editorial">
    <HeroBackdrop
      src="images/BACK-010.jpg"
      gradient="linear-gradient(90deg,rgba(10,12,11,.96),rgba(10,12,11,.64) 48%,rgba(10,12,11,.1))"
    />
    <div class="hero-grid"></div>
    <span class="hero-index">EMPRESA · EQUIPO · RECURSOS</span>
    <div class="hero-content">
      <span class="eyebrow">Conocé Calltruck</span>
      <h1>
        Detrás de cada carga,
        <br />
        <em>hay un equipo</em>
        <br />
        que responde.
      </h1>
      <p class="hero-lead">
        Somos una empresa familiar. Desde 2006, crecemos con el trabajo de cada
        día y el compromiso de acompañar cada carga.
      </p>
    </div>
  </section>
  <CompanyHistory />
  <section class="section section--sand reveal">
    <div class="section-inner">
      <div class="section-head">
        <div>
          <span class="eyebrow">Diferenciales</span>
          <h2>Recursos reales. Soluciones concretas.</h2>
        </div>
      </div>
      <div class="check-grid">
        {items.map((item, i) => (
          <div class="check-item">
            <i>0{i + 1}</i>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--dark reveal">
    <div class="section-inner editorial editorial--visual">
      <div class="editorial-media">
        <aside>03 / Especialización</aside>
        <figure>
          <SiteImage
            src="images/editorial/actros-port-twilight.webp"
            alt="Mercedes-Benz Actros de Calltruck operando junto a una terminal portuaria"
            loading="lazy"
          />
        </figure>
      </div>
      <article>
        <h2>Experiencia en logística especializada.</h2>
        <p>
          Nuestra presentación comercial contempla operaciones IMO, contenedores
          y cargas generales, logística inversa, importación y exportación, y
          servicio aduanero (ATA).
        </p>
        <p>
          El alcance específico de cada operación se confirma al momento de la
          consulta.
        </p>
      </article>
    </div>
  </section>
  <CTA
    title="El próximo movimiento empieza con una conversación."
    text="Contanos qué necesita tu operación y evaluemos juntos la mejor forma de acompañarla."
    label="Contactar a Calltruck"
  />
</BaseLayout>

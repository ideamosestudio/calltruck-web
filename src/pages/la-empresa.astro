---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import FleetGallery from '../components/FleetGallery.astro';
const items=['Cobertura de corta, media y larga distancia.','Flota propia y unidades tercerizadas.','Seguimiento satelital de las operaciones.','Depósito de más de 1.000 m².','Equipamiento para diferentes tipos de cargas.','Compromiso con los tiempos de entrega.'];
---
<BaseLayout title="La empresa | Calltruck Transporte y Logística" description="Conocé Calltruck: flota propia, unidades tercerizadas, cobertura nacional, seguimiento satelital e infraestructura logística.">
  <section class="hero hero--service hero--editorial" style="background-image:linear-gradient(90deg,rgba(10,12,11,.96),rgba(10,12,11,.64) 48%,rgba(10,12,11,.1)),url('images/editorial/hero-company.webp')"><div class="hero-grid"></div><span class="hero-index">EMPRESA · EQUIPO · RECURSOS</span><div class="hero-content"><span class="eyebrow">Conocé Calltruck</span><h1>Detrás de cada carga,<br><em>hay un equipo</em><br>que responde.</h1><p class="hero-lead">Somos una empresa de transporte y logística que desarrolla soluciones para distintas necesidades de traslado, distribución y almacenamiento.</p></div></section>
  <section class="section reveal"><div class="section-inner editorial"><aside>01 / Quiénes somos</aside><article><h2>Logística pensada para resolver.</h2><p>En Calltruck combinamos experiencia, flota propia, unidades tercerizadas, infraestructura estratégica y seguimiento operativo en tiempo real.</p><p>Trabajamos con empresas de todo el país y adaptamos nuestros recursos a las características de cada operación. Nuestro compromiso es ofrecer respuestas concretas, acompañar cada etapa del servicio y cumplir con los tiempos acordados.</p></article></div></section>
  <section class="section section--sand reveal"><div class="section-inner"><div class="section-head"><div><span class="eyebrow">Diferenciales</span><h2>Recursos reales. Soluciones concretas.</h2></div></div><div class="check-grid">{items.map((item,i)=><div class="check-item"><i>0{i+1}</i><span>{item}</span></div>)}</div></div></section>
  <section class="section section--fleet reveal"><div class="section-inner"><div class="section-head"><div><span class="eyebrow">Capacidad operativa</span><h2>Una flota preparada para distintos desafíos.</h2></div><p>Disponemos de chasis de 8 a 14 pallets, unidades con pala hidráulica, semirremolques, equipos especiales y utilitarios para responder a diferentes tipos de operaciones.</p></div><FleetGallery /></div></section>
  <section class="section section--dark reveal"><div class="section-inner editorial"><aside>03 / Especialización</aside><article><h2>Experiencia en logística especializada.</h2><p>Nuestra presentación comercial contempla operaciones IMO, contenedores y cargas generales, logística inversa, importación y exportación, y servicio aduanero (ATA).</p><p>El alcance específico de cada operación se confirma al momento de la consulta.</p></article></div></section>
  <CTA title="El próximo movimiento empieza con una conversación." text="Contanos qué necesita tu operación y evaluemos juntos la mejor forma de acompañarla." label="Contactar a Calltruck" />
</BaseLayout>
